# Copy to .env.local and fill in. .env.local is git-ignored.

# --- Supabase (optional: the public demo runs without these) ---
# Project URL and the *anon (public)* key. Both are safe for the browser because
# access is enforced by Row Level Security (see database/schema.sql).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "demo"     -> read local sample data from data/demo (default, no credentials needed)
# "supabase" -> read published data from Supabase (requires the two values above)
NEXT_PUBLIC_DATA_MODE=demo

# Local-development-only demo admin (edits stay in this browser's localStorage).
# It is ignored unless NODE_ENV=development AND Supabase is not in use.
# It has NO password and is NOT security; it never works in a production build.
NEXT_PUBLIC_DEMO_ADMIN=false

# NOTE: This app intentionally does not use a Supabase service-role key.
# All admin writes run as the signed-in staff user and are enforced by RLS.
# Never put a service-role key in any NEXT_PUBLIC_* variable or in client code.
